# ------------------------------------------------------------------
# BJS Prep — Environment Variables
# Copy to .env.local for local development.
# Add the same keys to Vercel → Project Settings → Environment
# Variables for production.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# MongoDB Atlas
# Local: use the same URI as production, or a dev cluster.
# IP allowlist: add your current IP for local dev.
# For Vercel: add 0.0.0.0/0 (Vercel IPs are dynamic).
# ------------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bjs-prep

# ------------------------------------------------------------------
# JWT secret — 64+ random characters.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------------
# Google OAuth (optional for social login)
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# Gmail SMTP — sends verification codes and password resets.
# Generate an App Password at:
#   https://myaccount.google.com/apppasswords
# GMAIL_APP_PASSWORD is 16 characters, no spaces.
# ------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------
# Public base URL.
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Cloudinary — used for images and PDF uploads.
# The NEXT_PUBLIC_* pair is used by the browser for direct
# unsigned uploads. The server trio is used for deletion.
# ------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Node environment. Leave as "development" locally.
# Vercel sets this automatically to "production".
# ------------------------------------------------------------------
NODE_ENV=development
SESSION_MAX_AGE_DAYS=7
SESSION_REFRESH_AFTER_DAYS=6
SESSION_BIND_IP=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
